{
  "name": "tether",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:check": "vitest run src/content",
    "content:list": "node tools/list-questions.ts",
    "tokens": "python3 tools/tokens/tokens.py && python3 tools/tokens/gen_css.py",
    "screens": "playwright test -c playwright.screens.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "blobatar": "2.7.0",
    "cuelume": "0.2.8",
    "idb-keyval": "^6.3.0",
    "preact": "^11.0.1",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
