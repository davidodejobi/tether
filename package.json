{
  "name": "tether",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:check": "vitest run src/content",
    "content:list": "node tools/list-questions.ts"
  },
  "dependencies": {
    "preact": "^11.0.1",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
